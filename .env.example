# Пример переменных окружения. Скопируй в .env и подставь свои значения.
# Файл .env НЕ коммитить (уже в .gitignore).

# Prisma: путь к SQLite (для локальной разработки)
DATABASE_URL="file:./db/custom.db"

# Для боевого режима — вставь URL развёрнутого GAS Web App
# (он же должен быть в public/pwa/js/api.js: CONFIG.GAS_URL
#  и в public/pwa/printer/config.json: gas.webapp_url)
# NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/XXXX/exec
