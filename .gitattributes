# Нормализация переносов строк: LF в репозитории, ОС-специфичные при checkout
* text=auto eol=lf

# JS/TS/CSS/HTML/JSON/MD/GS/PY — всегда LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gs text eol=lf
*.py text eol=lf
*.mjs text eol=lf

# SVG как текст (для diff)
*.svg text eol=lf

# Бинарные файлы
*.db binary
*.png binary
*.jpg binary
*.pdf binary
